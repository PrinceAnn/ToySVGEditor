{
  "name": "toy-svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "An object-oriented SVG CLI editor for Advanced Software Design Lab 1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
